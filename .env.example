# Copy to .env and edit. All values are optional.
PORT=3000
HOST=127.0.0.1
# First-run admin account (only used when no admin exists yet).
ADMIN_USERNAME=admin
# Leave empty to have a random password generated and printed once on first start.
ADMIN_PASSWORD=
SESSION_TTL_HOURS=8
# Set to true when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
LOG_LEVEL=info
